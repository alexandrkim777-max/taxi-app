# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://taxi:taxi@localhost:5432/taxi
REDIS_URL=redis://localhost:6379
DEFAULT_CITY_CODE=tashkent
# Production: a random string of 32+ characters, e.g. from `openssl rand -hex 32`
AUTH_SECRET=dev-only-change-me
# console = print SMS codes to the API log (development only; refused in production)
SMS_PROVIDER=console
# true only behind our own reverse proxy, so rate limits see real client IPs
TRUST_PROXY=false
# Document uploads are accepted only from our own storage
FILE_BASE_URL=https://files.example/
# Route engine: 'osrm' (self-hosted, set OSRM_URL) or 'estimate' (straight-line estimate, development)
ROUTE_PROVIDER=estimate
OSRM_URL=http://localhost:5000

# Payments. Development: fake provider (approves payments without money, refused in production).
# Production: e.g. PAYMENT_PROVIDERS=payme,click with their credentials below.
PAYMENT_PROVIDERS=fake
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts saved card tokens. Required in production.
PAYMENT_TOKEN_KEY=
PAYMENT_RETURN_URL=taxiapp://payment-result
PUBLIC_BASE_URL=http://localhost:3000
FAKE_PAYMENT_SECRET=dev-fake-payment-secret
# Payme (fill in when merchant access is granted)
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_WEBHOOK_IPS=
# Click
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=
CLICK_WEBHOOK_IPS=
# Uzum Bank
UZUM_MERCHANT_ID=
UZUM_SECRET_KEY=
UZUM_WEBHOOK_IPS=

# Private files (driver documents). Signed links use PUBLIC_API_URL.
FILE_STORAGE_DIR=./var/files
PUBLIC_API_URL=http://localhost:3000

# Push notifications. log = development (nothing is sent). expo = Expo push service (required in
# production); EXPO_ACCESS_TOKEN is optional but recommended (enhanced push security in the Expo account).
PUSH_PROVIDER=log
EXPO_ACCESS_TOKEN=
