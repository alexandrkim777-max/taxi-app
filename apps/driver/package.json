{
  "name": "@taxi/driver",
  "private": true,
  "version": "0.1.0",
  "main": "index.ts",
  "scripts": {
    "tokens": "node scripts/tokens-to-ts.mjs",
    "start": "npm run tokens && expo start",
    "android": "npm run tokens && expo start --android",
    "ios": "npm run tokens && expo start --ios",
    "web": "npm run tokens && expo start --web",
    "build:demo": "npm run tokens && EXPO_PUBLIC_DEMO=1 expo export --platform web --output-dir dist-demo && node scripts/inline.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "3.2.3",
    "expo": "51.0.39",
    "expo-constants": "16.0.2",
    "expo-device": "6.0.2",
    "expo-haptics": "13.0.1",
    "expo-image-picker": "15.0.7",
    "expo-keep-awake": "13.0.2",
    "expo-linking": "6.3.1",
    "expo-location": "17.0.1",
    "expo-notifications": "0.28.19",
    "expo-secure-store": "13.0.2",
    "expo-status-bar": "1.12.1",
    "expo-system-ui": "3.0.7",
    "expo-task-manager": "11.8.2",
    "expo-web-browser": "13.0.3",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "4.10.5",
    "react-native-web": "0.19.12"
  },
  "devDependencies": {
    "@babel/core": "7.24.9",
    "@types/react": "18.2.79",
    "typescript": "5.6.3"
  }
}
