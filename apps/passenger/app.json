{
  "expo": {
    "name": "Taxi",
    "slug": "taxi-passenger",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "taxi",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "bundleIdentifier": "uz.taxi.passenger",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "To put the pickup pin where you are and show cars nearby."
      }
    },
    "android": {
      "package": "uz.taxi.passenger",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0B6A70"
      }
    },
    "plugins": [
      "@maplibre/maplibre-react-native",
      "expo-secure-store",
      "expo-location",
      [
        "expo-notifications",
        {
          "color": "#0B6A70"
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    },
    "owner": "alexandr888s-team",
    "splash": {
      "backgroundColor": "#0B6A70",
      "resizeMode": "contain"
    },
    "backgroundColor": "#F7F2EA"
  }
}
